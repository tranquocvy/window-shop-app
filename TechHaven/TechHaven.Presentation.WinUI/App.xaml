<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TechHaven.Presentation.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Theme dictionaries are loaded by ThemeManager at runtime -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

            <!-- Keep navigation item sizing/style but do NOT force Foreground here (it overrides theme) -->
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="60"/>
            </Style>

            <!-- Avoid forcing icon foreground globally -->
            <Style TargetType="FontIcon">
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <!-- Fallback CardStyle so pages can reference it before theme dictionaries load -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TH.CardBackground}" />
                <Setter Property="CornerRadius" Value="{ThemeResource TH.Radius.Medium}" />
                <Setter Property="BorderBrush" Value="{ThemeResource TH.BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- Fallback on-primary text color used on PrimaryBrush buttons -->
            <SolidColorBrush x:Key="TH.TextOnPrimary" Color="#FFFFFFFF" />

            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
