<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TechHaven.Presentation.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Theme dictionaries are loaded by ThemeManager at runtime -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Keep navigation item sizing/style but do NOT force Foreground here (it overrides theme) -->
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="60"/>
            </Style>

            <!-- Avoid forcing icon foreground globally -->
            <Style TargetType="FontIcon">
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
