<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" Background="{ThemeResource TH.SurfaceBackground}">
        <StackPanel Spacing="18">
            <TextBlock x:Name="titleText" Text="Application Settings" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TH.TextPrimary}"/>

            <!-- Row 1: Current user info -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource TH.PrimaryBrush}" VerticalAlignment="Center">
                    <TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TH.TextPrimary}" FontWeight="SemiBold"/>
                </Border>

                <StackPanel>
                    <TextBlock x:Name="currentUserFullNameText" Text="Not signed in" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TH.TextPrimary}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="6">
                            <TextBlock Text="Username" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <TextBlock Text="Role" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <TextBlock Text="Email" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="6">
                            <TextBlock x:Name="currentUserUserNameText" Text="" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}" />
                            <TextBlock x:Name="currentUserRoleText" Text="-" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <TextBlock x:Name="currentUserEmailText" Text="" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </StackPanel>

            <!-- Row 2: Theme selection -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock x:Name="colorModeLabel" Text="Color mode" VerticalAlignment="Center" Foreground="{ThemeResource TH.TextPrimary}"/>

                <Button x:Name="themeButton" Click="ThemeButton_Click" Margin="8,0,0,0" Background="{ThemeResource TH.PrimaryBrush}" Foreground="White" Padding="8,6"/>

                <!-- New: Page size control -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="24,0,0,0">
                    <TextBlock Text="Items per page" VerticalAlignment="Center" Foreground="{ThemeResource TH.TextPrimary}"/>
                    <ComboBox x:Name="pageSizeCombo" Width="80" SelectionChanged="PageSizeCombo_SelectionChanged"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="themeStatusText" Foreground="{ThemeResource TH.TextSecondary}"/>

            <!-- Add user form (horizontal dashboard-style card) -->
            <Border x:Name="addUserBorder" Style="{ThemeResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Create new user" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TH.TextPrimary}" />
                    <TextBlock Text="Quickly add an account from here" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" Margin="0,4,0,12"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Full name" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <TextBox x:Name="newUserFullNameBox" PlaceholderText="Full name" Foreground="{ThemeResource TH.TextPrimary}" Background="{ThemeResource TH.CardBackground}"/>

                            <TextBlock Text="Email" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" Margin="0,8,0,0"/>
                            <TextBox x:Name="newUserEmailBox" PlaceholderText="Email" Foreground="{ThemeResource TH.TextPrimary}" Background="{ThemeResource TH.CardBackground}"/>
                            <TextBlock x:Name="newUserEmailErrorText" Foreground="{ThemeResource TH.DangerBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Username" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <TextBox x:Name="newUserUserNameBox" PlaceholderText="Username" Foreground="{ThemeResource TH.TextPrimary}" Background="{ThemeResource TH.CardBackground}"/>
                            <TextBlock x:Name="newUserUserNameErrorText" Foreground="{ThemeResource TH.DangerBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap" />

                            <TextBlock Text="Password" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="newUserPasswordBox" PlaceholderText="Password" Foreground="{ThemeResource TH.TextPrimary}" Background="{ThemeResource TH.CardBackground}"/>
                            <TextBlock x:Name="newUserPasswordErrorText" Foreground="{ThemeResource TH.DangerBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap" />

                            <TextBlock Text="Confirm password" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" Margin="0,8,0,0"/>
                            <PasswordBox x:Name="newUserConfirmPasswordBox" PlaceholderText="Confirm password" Foreground="{ThemeResource TH.TextPrimary}" Background="{ThemeResource TH.CardBackground}"/>
                            <TextBlock x:Name="newUserConfirmErrorText" Foreground="{ThemeResource TH.DangerBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Role" FontSize="12" Foreground="{ThemeResource TH.TextSecondary}" />
                            <ComboBox x:Name="newUserRoleCombo" SelectedIndex="0" Width="160">
                                <ComboBoxItem Tag="1">Admin</ComboBoxItem>
                                <ComboBoxItem Tag="2">Seller</ComboBoxItem>
                            </ComboBox>

                            <Button x:Name="addUserButton" Content="Add user" Click="AddUserButton_Click" Background="{ThemeResource TH.PrimaryBrush}" Foreground="{ThemeResource TH.TextOnPrimary}" Padding="8,6" Width="160" CornerRadius="6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
