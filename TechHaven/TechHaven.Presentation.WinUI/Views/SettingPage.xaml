<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="18">
            <TextBlock Text="Application Settings" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

            <!-- Row 1: Current user info -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource SystemControlBackgroundAccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontWeight="SemiBold"/>
                </Border>

                <StackPanel>
                    <TextBlock x:Name="currentUserFullNameText" Text="Not signed in" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock x:Name="currentUserRoleText" Text="-" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Row 2: Theme selection -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Color mode" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                <Button x:Name="themeButton" Click="ThemeButton_Click" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="themeStatusText" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

        </StackPanel>
    </Grid>
</Page>
