<Page
    x:Class="TechHaven.Presentation.WinUI.Views.ProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:TechHaven.Presentation.WinUI.Views"
    xmlns:vm="using:TechHaven.Presentation.WinUI.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    x:Name="RootPage"
    mc:Ignorable="d"
      
    Background="{StaticResource TH.SurfaceBackground}"
    Foreground="{StaticResource TH.TextPrimary}">
    
    <!-- NOTE: Removed <Page.DataContext> to avoid creating a second ProductViewModel instance.
         ViewModel instance is created in code-behind and assigned to DataContext there. -->

    <Page.Resources>
        <converters:UrlToImageConverter x:Key="UrlToImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:PriceFormatConverter x:Key="PriceFormatConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>
  
    <Grid Padding="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionButtonsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="ActionButtonsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ActionButtonsPanel.Margin" Value="0,8,0,0" />
                        <Setter Target="ActionButtonsPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ActionButtonsPanel.Padding" Value="0,0,8,0" />

                        <Setter Target="FilterContainer.(Grid.ColumnSpan)" Value="2" />

                        <Setter Target="FilterCol0.Width" Value="*" />
                        <Setter Target="FilterCol1.Width" Value="*" />
                        <Setter Target="FilterCol2.Width" Value="*" />
                        <Setter Target="FilterCol3.Width" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="3" />

                        <Setter Target="BrandCombo.(Grid.Row)" Value="1" />
                        <Setter Target="BrandCombo.(Grid.Column)" Value="0" />

                        <Setter Target="PriceCombo.(Grid.Row)" Value="1" />
                        <Setter Target="PriceCombo.(Grid.Column)" Value="1" />

                        <Setter Target="StatusCombo.(Grid.Row)" Value="1" />
                        <Setter Target="StatusCombo.(Grid.Column)" Value="2" />
                        <Setter Target="StatusCombo.Margin" Value="0" />

                        <Setter Target="Col_CostPrice.Width" Value="1*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Products"
                   FontFamily="{StaticResource TH.Font.Main}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource TH.TextPrimary}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FilterContainer" Grid.Row="0" Grid.Column="0" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilterCol0" Width="2*" />
                    <ColumnDefinition x:Name="FilterCol1" Width="1.2*" />
                    <ColumnDefinition x:Name="FilterCol2" Width="1.2*" />
                    <ColumnDefinition x:Name="FilterCol3" Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="0"
                         PlaceholderText="Tìm kiếm..."
                         ToolTipService.ToolTip="Nhập tên sản phẩm để tìm nhanh"
                         Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox x:Name="BrandCombo" Grid.Row="0" Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.BrandNameFilter}"
                          SelectedItem="{x:Bind ViewModel.SelectedBrandName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Height="40" PlaceholderText="Hãng"
                          ToolTipService.ToolTip="Lọc theo hãng" />

                <ComboBox x:Name="PriceCombo" Grid.Row="0" Grid.Column="2"
                          ItemsSource="{x:Bind ViewModel.PriceRangeOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedPriceRange, Mode=TwoWay}"
                          PlaceholderText="Giá" HorizontalAlignment="Stretch" Height="40"
                          ToolTipService.ToolTip="Lọc theo khoảng giá" />

                <ComboBox x:Name="StatusCombo" Grid.Row="0" Grid.Column="3"
                          ItemsSource="{x:Bind ViewModel.StatusFilter}"
                          SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Height="40" PlaceholderText="Trạng thái" 
                          Margin="8,0,0,0"
                          ToolTipService.ToolTip="Lọc theo trạng thái"/>
            </Grid>

            <Grid x:Name="ActionButtonsPanel" Grid.Row="0" Grid.Column="1" 
              HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="4" Margin="8,-6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="AddProductButton" Grid.Column="0" Content="Thêm" ToolTipService.ToolTip="Thêm Sản Phẩm"
                   Style="{StaticResource TH.PrimaryButtonStyle}" FontWeight="Bold" Height="40" 
                   HorizontalAlignment="Stretch" Click="AddProduct_Click" />

                <Button x:Name="AddBrandButton" Grid.Column="1" Content="Hãng" ToolTipService.ToolTip="Thêm Danh Mục"
                   Background="{StaticResource TH.SecondaryBrush}" Foreground="White" FontWeight="Bold" Height="40" 
                   HorizontalAlignment="Stretch" Click="AddBrand_Click" />

                <Button x:Name="ImportExcelButton" Grid.Column="2" Height="40" Padding="0" Background="{StaticResource TH.SuccessBrush}" 
                   Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" Click="ImportExcel_Click" ToolTipService.ToolTip="Import file xlxs sản phẩm">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B5;" />
                        <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="DeleteSelectedButton" Grid.Column="3" Content="Xóa" ToolTipService.ToolTip="Xóa sản phẩm"
                       Background="{StaticResource TH.DangerBrush}" Foreground="White" FontWeight="Bold" Height="40"
                       HorizontalAlignment="Stretch" Command="{Binding DeleteSelectedCommand}"
                       Visibility="{x:Bind ViewModel.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,10" CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition x:Name="Col_CostPrice_Header"
                                         Width="{Binding DataContext.CostPriceColumnWidth, ElementName=RootPage}" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsAllSelected, Mode=TwoWay}" MinWidth="0" Margin="0" />
                    <TextBlock Grid.Column="1" Text="Ảnh" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="Tên Sản Phẩm" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                    <TextBlock Grid.Column="3" Text="Giá Nhập" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" Margin="-10,0,0,0" 
                               Visibility="{x:Bind ViewModel.IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Grid.Column="4" Text="Giá Bán" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                    <TextBlock Grid.Column="5" Text="SL" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                    <TextBlock Grid.Column="6" Text="Hãng" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                    <TextBlock Grid.Column="7" Text="Trạng Thái" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" />
                </Grid>

                <ListView Grid.Row="1"
                          SelectionMode="None"
                          ItemsSource="{Binding Products}"
                          IsItemClickEnabled="True"
                          ItemClick="ProductsList_ItemClick"
                          x:Name="ProductsListView"
                          Background="Transparent">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="48" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductItemViewModel">
                            <!-- bind Grid Background to DraftBackground to highlight drafts -->
                            <Grid Padding="12,6" Background="{Binding DraftBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2*" /> 
                                    <ColumnDefinition x:Name="Col_CostPrice_Header"
                                         Width="{Binding DataContext.CostPriceColumnWidth, ElementName=RootPage}" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0" />
                                <Border Grid.Column="1" CornerRadius="4" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,10,0">
                                    <Image Source="{Binding Product.ImageUrl, Converter={StaticResource UrlToImageConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Product.ProductName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Product.CostPrice, Converter={StaticResource PriceFormatConverter}}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TH.TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.IsAdmin, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Column="4" Text="{Binding Product.SellPrice, Converter={StaticResource PriceFormatConverter}}" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Product.StockQuantity}" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" />
                                <TextBlock Grid.Column="6" Text="{Binding Product.BrandName}" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="7" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Xem chi tiết" Click="ViewDetails_Click" />
                                        <MenuFlyoutItem Text="Xóa sản phẩm"
                                                        Command="{Binding DataContext.DeleteProductContextCommand, ElementName=ProductsListView}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsAdmin, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Spacing="8">
            <Button x:Name="ProductPrevPageButton" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                    ToolTipService.ToolTip="Trang trước" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PageInfo}" Foreground="{StaticResource TH.TextPrimary}" />
            <Button x:Name="ProductNextPageButton" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                    ToolTipService.ToolTip="Trang sau" />
        </StackPanel>
    </Grid>
</Page>