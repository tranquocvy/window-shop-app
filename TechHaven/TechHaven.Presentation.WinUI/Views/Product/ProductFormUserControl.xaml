<UserControl
    x:Class="TechHaven.Presentation.WinUI.Views.Controls.ProductFormUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="600" Height="Auto">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="16">

            <!-- Ảnh sản phẩm - Carousel với nút trái/phải -->
            <TextBlock Text="Ảnh sản phẩm" FontWeight="SemiBold"/>
            <StackPanel Spacing="8">
                <!-- Ảnh chính -->
                <Grid Width="400" Height="250">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" 
                            Background="WhiteSmoke"
                            Tapped="OnSelectImageTapped"
                            ToolTipService.ToolTip="Nhấn để thêm/thay đổi ảnh">
                        <Grid>
                            <FontIcon Glyph="&#xE958;" FontFamily="Segoe MDL2 Assets" 
                                      FontSize="48" Foreground="Silver"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <Image x:Name="CurrentImage" Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <!-- Nút chuyển trái -->
                    <Button x:Name="PrevButton"
                            Click="OnPreviousImage"
                            Width="40" Height="40"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Background="#80000000"
                            CornerRadius="20"
                            ToolTipService.ToolTip="Ảnh trước">
                        <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="White"/>
                    </Button>

                    <!-- Nút chuyển phải -->
                    <Button x:Name="NextButton"
                            Click="OnNextImage"
                            Width="40" Height="40"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Background="#80000000"
                            CornerRadius="20"
                            ToolTipService.ToolTip="Ảnh sau">
                        <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="White"/>
                    </Button>

                    <!-- Chỉ số ảnh hiện tại -->
                    <Border Background="#80000000" 
                            CornerRadius="12"
                            Padding="8,4"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="ImageIndexText" 
                                   Text="1 / 4" 
                                   Foreground="White" 
                                   FontSize="12"/>
                    </Border>
                </Grid>

                <!-- Thumbnails ảnh phía dưới -->
                <StackPanel x:Name="ThumbnailsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <!-- Thumbnails sẽ được thêm động từ code-behind -->
                </StackPanel>
            </StackPanel>


            <!-- Tên sản phẩm -->
            <TextBlock Text="Tên sản phẩm *" FontWeight="SemiBold"/>
            <TextBox x:Name="ProductNameBox" 
                     PlaceholderText="Nhập tên sản phẩm..." 
                     TextChanged="OnInputChanged"/>
            <TextBlock x:Name="ProductNameErrorText"
                       Text="Vui lòng nhập tên sản phẩm."
                       Foreground="Red" FontSize="12"
                       Visibility="Collapsed" Margin="0,-8,0,0"/>

            <!-- Thương hiệu -->
            <TextBlock Text="Thương hiệu" FontWeight="SemiBold"/>

            <ComboBox x:Name="BrandComboBox" 
                      PlaceholderText="Chọn thương hiệu..."
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnBrandSelectionChanged"/>

            <TextBlock x:Name="BrandNameErrorText"
                       Text="Phải chọn tên thương hiệu."
                       Foreground="Red" FontSize="12"
                       Visibility="Collapsed" Margin="0,-8,0,0"/>

            <!-- Mô tả -->
            <TextBlock Text="Mô tả" FontWeight="SemiBold"/>
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="120"
                     PlaceholderText="Mô tả chi tiết sản phẩm..." />

            <!-- Giá nhập -->
            <TextBlock Text="Giá nhập" FontWeight="SemiBold"/>
            <NumberBox x:Name="CostPriceBox" PlaceholderText="0" ValueChanged="OnNumberChanged"/>

            <!-- Giá bán -->
            <TextBlock Text="Giá bán *" FontWeight="SemiBold"/>
            <NumberBox x:Name="SellPriceBox" PlaceholderText="0" ValueChanged="OnNumberChanged"/>
            <TextBlock x:Name="SellPriceErrorText"
                       Text="Giá bán phải lớn hơn 0."
                       Foreground="Red" FontSize="12"
                       Visibility="Collapsed" Margin="0,-8,0,0"/>

            <!-- Số lượng tồn -->
            <TextBlock Text="Số lượng tồn *" FontWeight="SemiBold"/>
            <NumberBox x:Name="StockQuantityBox" PlaceholderText="0" ValueChanged="OnNumberChanged"/>
            <TextBlock x:Name="StockQuantityErrorText"
                       Text="Số lượng tồn không được âm."
                       Foreground="Red" FontSize="12"
                       Visibility="Collapsed" Margin="0,-8,0,0"/>

            <!-- Các thông số khác -->
            <TextBlock Text="Màu sắc" FontWeight="SemiBold"/>
            <TextBox x:Name="ColorBox" PlaceholderText="VD: Đen, Trắng..." />

            <TextBlock Text="Dung lượng lưu trữ (GB)" FontWeight="SemiBold"/>
            <NumberBox x:Name="StorageCapacityBox" PlaceholderText="64 / 128 / 256..." />

            <TextBlock Text="Bộ xử lý" FontWeight="SemiBold"/>
            <TextBox x:Name="ProcessorBox" PlaceholderText="VD: Snapdragon 8 Gen 2..." />

            <TextBlock Text="Kích thước màn hình (inch)" FontWeight="SemiBold"/>
            <NumberBox x:Name="ScreenSizeBox" PlaceholderText="6.1 / 6.7..." />

            <TextBlock Text="Dung lượng pin (mAh)" FontWeight="SemiBold"/>
            <NumberBox x:Name="BatteryCapacityBox" PlaceholderText="4000 / 5000..." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
