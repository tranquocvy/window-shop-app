<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:dto="using:TechHaven.Presentation.WinUI.Services.Interfaces"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TabButtonBackgroundConverter x:Key="TabButtonBackgroundConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />

        <!-- shared width for product name display and search box -->
        <x:Double x:Key="ProductNameWidth">360</x:Double>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TH.TextPrimary}" />
        </Style>

        <DataTemplate x:Key="ProductListItemTemplate" x:DataType="dto:ProductSummaryDto">
            <Grid Padding="8">
                <TextBlock Text="{x:Bind ProductName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TH.TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,4" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Seller summary cards (visible only to sellers) -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsSeller, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerOrderCount, Mode=OneWay}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Số đơn bán được" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Số đơn trong khoảng lọc" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE7BF;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerCommission, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Tiền hoa hồng" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Hoa hồng theo doanh thu" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE8C7;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>

        <!-- Filters: Date range, Year, Month, Search (visible only to admin) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Compact filter row similar to Orders page -->
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,4,0" />
                <CalendarDatePicker Grid.Column="1" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" Width="160" Height="32" HorizontalAlignment="Left" PlaceholderText="Từ ngày"/>

                <TextBlock Grid.Column="3" Text="Đến:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,4,0" />
                <CalendarDatePicker Grid.Column="4" Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" Width="160" Height="32" HorizontalAlignment="Left" PlaceholderText="Đến ngày"/>

                <TextBlock Grid.Column="6" Text="Năm:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,4,0" />
                <ComboBox Grid.Column="7" ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}" Width="120" Height="32"/>

                <TextBlock Grid.Column="8" Text="Tháng:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,4,0" />
                <ComboBox Grid.Column="9" ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}" Width="120" Height="32">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="11" ItemsSource="{x:Bind ViewModel.PeriodTypes}" SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}" Width="150" Height="32" HorizontalAlignment="Left"/>

                <Button Grid.Column="13"
                        Content="Tìm kiếm"
                        Command="{x:Bind ViewModel.LoadReportsCommand}"
                        Background="{StaticResource TH.PrimaryBrush}"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="16,6"
                        FontWeight="SemiBold"
                        Height="32"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chart Type Tabs (visible only to admin) -->
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Sản Phẩm"
                        Click="ProductChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Sản Phẩm'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"/>
                
                <Button Content="Doanh Thu"
                        Click="RevenueChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Doanh Thu'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"/>

                <!-- Commission tab only visible to full admins -->
                <Button Content="Hoa Hồng"
                        Click="CommissionTab_Click"
                        Visibility="{x:Bind ViewModel.IsFullAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Hoa Hồng'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Product selector moved to far right next to tabs area -->
            <Button Grid.Column="4" Margin="12,0,0,0" Width="300" Height="32" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="OpenProductPicker_Click"
                    HorizontalContentAlignment="Stretch"
                    Padding="12,4"
                    CornerRadius="8"
                    BorderBrush="{StaticResource TH.BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource TH.CardBackground}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="240" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Chart Area (conditional, admin only) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- placeholder area or additional controls if needed -->
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Product Chart -->
                        <Grid Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Product summary (layout only) -->
                                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Product name + stock in two rows, label and value in same row -->
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên Sản Phẩm:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,8" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tồn kho:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="100 cái" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,0" />
                                            </Grid>

                                            <!-- Right: Total sold + revenue in two rows, label and value in same row -->
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tổng bán:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="25 cái" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,8" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tổng thu về:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="625.000.000 đ" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Grid>
                                     </Border>

                                    <!-- Chart placeholder -->
                                    <Border Grid.Row="1" Background="{StaticResource TH.Layer1Background}" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="240">
                                        <Grid>
                                            <TextBlock Text="Biểu đồ Sản phẩm" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Revenue Chart (layout only) -->
                        <Grid Visibility="{x:Bind ViewModel.IsRevenueChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Top summary cards (layout only) -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                        <Border Background="{StaticResource TH.CardBackground}" Padding="12" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="TỔNG DOANH THU" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Text="{x:Bind ViewModel.TotalRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" />
                                                <TextBlock Text="{x:Bind ViewModel.RevenueGrowthText}" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource TH.CardBackground}" Padding="12" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="TỔNG LỢI NHUẬN" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Text="{x:Bind ViewModel.TotalProfit, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" />
                                                <TextBlock Text="{x:Bind ViewModel.RevenueGrowthText}" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Large placeholder for future chart drawing -->
                                    <Border Grid.Row="1" Background="{StaticResource TH.Layer1Background}" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="240" Margin="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Biểu đồ doanh thu" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Commission Table (visible only to full admin when selected) -->
                        <Grid Visibility="{x:Bind ViewModel.IsCommissionVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Bảng hoa hồng nhân viên" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TH.TextPrimary}" />

                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CommissionData}" Margin="0,12,0,0">
                                        <ListView.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="Họ và Tên" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="Vai trò" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="3" Text="Doanh số" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="4" Text="% HH" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="5" Text="Tiền HH" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.HeaderTemplate>

                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="reports:CommissionReportDto" xmlns:reports="using:TechHaven.Shared.DTOs.Reports">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{x:Bind UserId, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind UserFullName, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind RoleName, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind TotalSales, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right">
                                                        <Run Text="{x:Bind CommissionRate}" />
                                                        <Run Text="%" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="5" Text="{x:Bind CommissionAmount, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Footer: total commission -->
                                    <Border Grid.Row="2" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1,0,0,0" Padding="12" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="TỔNG CỘNG PHẢI TRẢ:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalCommission, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
