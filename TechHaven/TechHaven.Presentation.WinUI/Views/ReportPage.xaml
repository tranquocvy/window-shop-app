<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TabButtonBackgroundConverter x:Key="TabButtonBackgroundConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TH.TextPrimary}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Báo Cáo" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TH.TextPrimary}"/>

        <!-- Seller summary cards (visible only to sellers) -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsSeller, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerOrderCount, Mode=OneWay}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Số đơn bán được" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Số đơn trong khoảng lọc" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE7BF;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerCommission, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Tiền hoa hồng" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Hoa hồng theo doanh thu" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE8C7;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>

        <!-- Filters: Date range, Year, Month, Search (visible only to admin) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Compact filter row similar to Orders page -->
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,4,0" />
                <CalendarDatePicker Grid.Column="1" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" Width="160" Height="32" HorizontalAlignment="Left" PlaceholderText="Từ ngày"/>

                <TextBlock Grid.Column="3" Text="Đến:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,4,0" />
                <CalendarDatePicker Grid.Column="4" Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" Width="160" Height="32" HorizontalAlignment="Left" PlaceholderText="Đến ngày"/>

                <TextBlock Grid.Column="6" Text="Năm:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,4,0" />
                <ComboBox Grid.Column="7" ItemsSource="{x:Bind ViewModel.Years}" SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}" Width="120" Height="32"/>

                <TextBlock Grid.Column="8" Text="Tháng:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,4,0" />
                <ComboBox Grid.Column="9" ItemsSource="{x:Bind ViewModel.Months}" SelectedItem="{x:Bind ViewModel.SelectedMonth, Mode=TwoWay}" Width="120" Height="32">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="11" ItemsSource="{x:Bind ViewModel.PeriodTypes}" SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}" Width="150" Height="32" HorizontalAlignment="Left"/>

                <Button Grid.Column="13"
                        Content="Tìm kiếm"
                        Command="{x:Bind ViewModel.LoadReportsCommand}"
                        Background="{StaticResource TH.PrimaryBrush}"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="16,6"
                        FontWeight="SemiBold"
                        Height="32"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chart Type Tabs (visible only to admin) -->
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Sản Phẩm"
                        Click="ProductChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Sản Phẩm'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"/>
                
                <Button Content="Doanh Thu"
                        Click="RevenueChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Doanh Thu'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Product selector moved next to tabs, only visible when product tab active -->
            <ComboBox Grid.Column="3" Margin="12,0,0,0" Width="300" Height="32" Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{x:Bind ViewModel.Products}"
                      SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                      DisplayMemberPath="ProductName"
                      PlaceholderText="Chọn sản phẩm"/>
        </Grid>

        <!-- Chart Area (conditional, admin only) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Biểu đồ" Style="{StaticResource SectionTitle}" />

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- placeholder area or additional controls if needed -->
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Product Chart -->
                        <Grid Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid>
                                    <TextBlock Text="Biểu đồ - Sản phẩm" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}"/>
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Revenue Chart -->
                        <Grid Visibility="{x:Bind ViewModel.IsRevenueChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid>
                                    <TextBlock Text="Biểu đồ - Doanh thu" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}"/>
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
