<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:TabButtonBackgroundConverter x:Key="TabButtonBackgroundConverter"/>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TH.TextPrimary}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Báo Cáo" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TH.TextPrimary}"/>

        <!-- Filters -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Từ ngày:" 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TH.TextPrimary}"/>
            <DatePicker Grid.Column="1" 
                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Column="2" 
                       Text="Đến ngày:" 
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{StaticResource TH.TextPrimary}"/>
            <DatePicker Grid.Column="3" 
                        Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"/>

            <Button Grid.Column="5"
                    Content="Tải báo cáo"
                    Command="{x:Bind ViewModel.LoadReportsCommand}"
                    Background="{StaticResource TH.PrimaryBrush}"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="24,8"
                    FontWeight="SemiBold"/>
        </Grid>

        <!-- Chart Type Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Sản Phẩm"
                    Click="ProductChartTab_Click"
                    Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Sản Phẩm'}"
                    Foreground="{StaticResource TH.TextPrimary}"
                    BorderBrush="{StaticResource TH.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,10"
                    FontWeight="SemiBold"/>
            
            <Button Content="Doanh Thu"
                    Click="RevenueChartTab_Click"
                    Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Doanh Thu'}"
                    Foreground="{StaticResource TH.TextPrimary}"
                    BorderBrush="{StaticResource TH.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,10"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Product Sales Chart (Line Chart) -->
        <Border Grid.Row="3" 
                Style="{StaticResource CardStyle}"
                Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Sản Phẩm Bán Theo Thời Gian" 
                           Style="{StaticResource SectionTitle}"/>

                <!-- Product and Label Selector -->
                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Product" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TH.TextPrimary}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.Products}"
                              SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                              DisplayMemberPath="ProductName"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Chọn sản phẩm"/>

                    <TextBlock Grid.Column="2" 
                               Text="Label" 
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource TH.TextPrimary}"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{x:Bind ViewModel.PeriodTypes}"
                              SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Line Chart Area -->
                <Border Grid.Row="2" 
                        Background="{StaticResource TH.Layer1Background}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        MinHeight="400">
                    <Grid x:Name="LineChartContainer">
                        <TextBlock Text="Biểu đồ đường - Sản phẩm bán theo thời gian" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TH.TextSecondary}"/>
                        
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="50"
                                      Height="50"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Revenue & Profit Chart (Bar Chart) -->
        <Border Grid.Row="3" 
                Style="{StaticResource CardStyle}"
                Visibility="{x:Bind ViewModel.IsRevenueChartVisible, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Doanh Thu và Lợi Nhuận" 
                           Style="{StaticResource SectionTitle}"/>

                <!-- Label Selector -->
                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Label" 
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TH.TextPrimary}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.PeriodTypes}"
                              SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Bar Chart Area -->
                <Border Grid.Row="2" 
                        Background="{StaticResource TH.Layer1Background}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        MinHeight="400">
                    <Grid x:Name="BarChartContainer">
                        <TextBlock Text="Biểu đồ cột - Doanh thu và lợi nhuận" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TH.TextSecondary}"/>

                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="50"
                                      Height="50"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,10,10,0"
                                    Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="20" Height="20" Fill="#4472C4" RadiusX="4" RadiusY="4"/>
                                <TextBlock Text="Doanh Thu" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="20" Height="20" Fill="#70AD47" RadiusX="4" RadiusY="4"/>
                                <TextBlock Text="Lợi Nhuận" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
