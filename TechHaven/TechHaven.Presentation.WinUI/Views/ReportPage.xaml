<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:dto="using:TechHaven.Presentation.WinUI.Services.Interfaces"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:lvcm="using:LiveChartsCore.Measure"
    mc:Ignorable="d"
    Background="{ThemeResource TH.SurfaceBackground}">

    <Page.Resources>
        <converters:TabButtonBackgroundConverter x:Key="TabButtonBackgroundConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />

        <!-- shared width for product name display and search box -->
        <x:Double x:Key="ProductNameWidth">360</x:Double>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TH.SurfaceBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{ThemeResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{ThemeResource TH.TextPrimary}" />
        </Style>

        <DataTemplate x:Key="ProductListItemTemplate" x:DataType="dto:ProductSummaryDto">
            <Grid Padding="8">
                <TextBlock Text="{x:Bind ProductName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TH.TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,4" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="20" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="721" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DesktopFilters.Visibility" Value="Visible" />
                        <Setter Target="TabletFilters.Visibility" Value="Collapsed" />
                        <Setter Target="DesktopTabs.Visibility" Value="Visible" />
                        <Setter Target="TabletTabs.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tablet">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DesktopFilters.Visibility" Value="Collapsed" />
                        <Setter Target="TabletFilters.Visibility" Value="Visible" />
                        <Setter Target="DesktopTabs.Visibility" Value="Collapsed" />
                        <Setter Target="TabletTabs.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Seller summary cards (visible only to sellers) -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsSeller, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerOrderCount, Mode=OneWay}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Số đơn bán được" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Số đơn trong khoảng lọc" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE7BF;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SellerCommission, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="Tiền hoa hồng" FontSize="20" Foreground="{StaticResource TH.TextSecondary}" />
                        <TextBlock Text="Hoa hồng theo doanh thu" FontSize="12" Foreground="{StaticResource TH.TextDisabled}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2" Glyph="&#xE8C7;" Foreground="{StaticResource TH.TextSecondary}" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>

        <!-- Desktop Filters -->
        <Border x:Name="DesktopFilters" Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.CanExport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Single-row layout: all filters and buttons inline -->
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- From label -->
                    <ColumnDefinition Width="300" />   <!-- From picker -->
                    <ColumnDefinition Width="12" />

                    <ColumnDefinition Width="Auto" />   <!-- To label -->
                    <ColumnDefinition Width="300" />   <!-- To picker -->
                    <ColumnDefinition Width="12" />

                    <ColumnDefinition Width="Auto" />   <!-- Period label -->
                    <ColumnDefinition Width="120" />   <!-- Period combo -->

                    <ColumnDefinition Width="*" />     <!-- spacer pushes buttons right -->
                    <ColumnDefinition Width="Auto" />  <!-- Search button -->
                    <ColumnDefinition Width="Auto" />  <!-- Export button -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" />
                <DatePicker Grid.Column="1" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" Width="300" Height="32" HorizontalAlignment="Left" />

                <TextBlock Grid.Column="3" Text="Đến:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" />
                <DatePicker Grid.Column="4" Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" Width="300" Height="32" HorizontalAlignment="Left" />

                <TextBlock Grid.Column="6" Text="Theo:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,4,0" />
                <ComboBox x:Name="PeriodCombo" Grid.Column="7" ItemsSource="{x:Bind ViewModel.PeriodTypes}" SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}" Width="120" Height="32" HorizontalAlignment="Left"
                          ToolTipService.ToolTip="Chọn kỳ xem báo cáo (Ngày/Tháng/Năm)" />

                <Button Grid.Column="9"
                        Command="{x:Bind ViewModel.LoadReportsCommand}"
                        Background="{StaticResource TH.PrimaryBrush}"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="10,6"
                        Height="32"
                        ToolTipService.ToolTip="Tải dữ liệu báo cáo theo bộ lọc">
                    <FontIcon Glyph="&#xE721;" />
                </Button>

                <Button x:Name="ExportButton" Grid.Column="10"
                        Click="ExportReport_Click"
                        Background="{StaticResource TH.CardBackground}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource TH.TextPrimary}"
                        CornerRadius="8"
                        Padding="10,6"
                        Height="32"
                        Margin="8,0,0,0"
                        ToolTipService.ToolTip="Xuất báo cáo ra file">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9F9;" VerticalAlignment="Center" />
                        <TextBlock Text="Xuất" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Tablet Filters -->
        <Border x:Name="TabletFilters" Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <Grid ColumnSpacing="8" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Start Date + Period Type -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" />
                <DatePicker Grid.Row="0" Grid.Column="1" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" Height="32" HorizontalAlignment="Stretch" />
                <ComboBox x:Name="TabletPeriodCombo" Grid.Row="0" Grid.Column="2" ItemsSource="{x:Bind ViewModel.PeriodTypes}" SelectedItem="{x:Bind ViewModel.SelectedPeriodType, Mode=TwoWay}" MinWidth="120" Height="32" HorizontalAlignment="Right"
                          ToolTipService.ToolTip="Chọn kỳ xem báo cáo (Ngày/Tháng/Năm)" />

                <!-- Row 1: End Date + View + Export -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đến:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" />
                <DatePicker Grid.Row="1" Grid.Column="1" Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" Height="32" HorizontalAlignment="Stretch" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="TabletSearchButton" Command="{x:Bind ViewModel.LoadReportsCommand}"
                            Background="{StaticResource TH.PrimaryBrush}"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="12,6"
                            Height="32"
                            ToolTipService.ToolTip="Tải dữ liệu báo cáo theo bộ lọc">
                        <TextBlock Text="Xem" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="TabletExportButton" Click="ExportReport_Click"
                            Background="{StaticResource TH.CardBackground}"
                            BorderBrush="{StaticResource TH.BorderBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource TH.TextPrimary}"
                            CornerRadius="8"
                            Padding="12,6"
                            Height="32"
                            ToolTipService.ToolTip="Xuất báo cáo ra file">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9F9;" VerticalAlignment="Center" />
                            <TextBlock Text="Xuất" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Desktop Tabs -->
        <Grid x:Name="DesktopTabs" Grid.Row="2" Visibility="{x:Bind ViewModel.CanExport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Sản Phẩm"
                        Click="ProductChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Sản Phẩm'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem biểu đồ theo sản phẩm"/>
                
                <Button Content="Doanh Thu"
                        Click="RevenueChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Doanh Thu'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem biểu đồ doanh thu"/>

                <!-- Commission tab only visible to full admins -->
                <Button Content="Hoa Hồng"
                        Click="CommissionTab_Click"
                        Visibility="{x:Bind ViewModel.IsFullAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Hoa Hồng'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem bảng hoa hồng"/>
            </StackPanel>

            <!-- Product selector moved to far right next to tabs area; now includes label -->
            <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" FontWeight="SemiBold" Margin="0,0,6,0" />

                <Button Width="300" Height="32" HorizontalAlignment="Right"
                        Click="OpenProductPicker_Click"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,4"
                        CornerRadius="8"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource TH.CardBackground}"
                        ToolTipService.ToolTip="Chọn sản phẩm để xem biểu đồ">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay, TargetNullValue='Chọn sản phẩm'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="240" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tablet Tabs -->
        <StackPanel x:Name="TabletTabs" Grid.Row="2" Orientation="Vertical" Spacing="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sản Phẩm"
                        Click="ProductChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Sản Phẩm'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem biểu đồ theo sản phẩm"/>
                
                <Button Content="Doanh Thu"
                        Click="RevenueChartTab_Click"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Doanh Thu'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem biểu đồ doanh thu"/>

                <Button Content="Hoa Hồng"
                        Click="CommissionTab_Click"
                        Visibility="{x:Bind ViewModel.IsFullAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{x:Bind ViewModel.SelectedChartTab, Mode=OneWay, Converter={StaticResource TabButtonBackgroundConverter}, ConverterParameter='Hoa Hồng'}"
                        Foreground="{StaticResource TH.TextPrimary}"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Height="32"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Xem bảng hoa hồng"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Spacing="6" Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}" FontWeight="SemiBold" />
                <Button Height="32"
                        MinWidth="340"
                        Click="OpenProductPicker_Click"
                        HorizontalContentAlignment="Stretch"
                        Padding="12,6"
                        CornerRadius="8"
                        BorderBrush="{StaticResource TH.BorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource TH.CardBackground}"
                        ToolTipService.ToolTip="Chọn sản phẩm để xem biểu đồ">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay, TargetNullValue='Chọn sản phẩm'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Chart Area (conditional, visible to roles that can view reports) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.CanExport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <!-- placeholder area or additional controls if needed -->
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Product Chart -->
                        <Grid Visibility="{x:Bind ViewModel.IsProductChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Product summary (layout only) -->
                                    <Border Grid.Row="0" Background="{StaticResource TH.Layer1Background}" Style="{StaticResource CardStyle}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Product name + stock in two rows, label and value in same row -->
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên Sản Phẩm:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,8" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tồn kho:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ProductStockText, Mode=OneWay}" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,0" />
                                            </Grid>

                                            <!-- Right: Total sold + revenue in two rows, label and value in same row -->
                                            <Grid Grid.Column="1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tổng bán:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ProductTotalSoldText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,8" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tổng thu về:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ProductTotalRevenueValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Grid>
                                     </Border>

                                    <!-- Product chart: show prompt when no product selected; show chart when selected -->
                                    <Border Grid.Row="1" Background="{StaticResource TH.Layer1Background}" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="240">
                                        <Grid Padding="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SelectedProduct.ProductName, Mode=OneWay, TargetNullValue='Chưa chọn sản phẩm'}" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}" Margin="0,0,0,8" />

                                            <Grid Grid.Row="1">
                                                <TextBlock Text="Vui lòng chọn sản phẩm để hiển thị biểu đồ" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextSecondary}" Visibility="{x:Bind ViewModel.IsProductNotSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <lvc:CartesianChart Series="{x:Bind ViewModel.ProductChartSeries, Mode=OneWay}" XAxes="{x:Bind ViewModel.ProductXAxes, Mode=OneWay}" LegendPosition="Top" Visibility="{x:Bind ViewModel.IsProductSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Revenue Chart (layout only) -->
                        <Grid Visibility="{x:Bind ViewModel.IsRevenueChartVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360">
                                <Grid Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Top summary cards (layout only) -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                        <Border Background="{StaticResource TH.CardBackground}" Padding="12" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="TỔNG DOANH THU" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" />
                                                <TextBlock Text="{Binding RevenueGrowthText}" FontSize="12" Foreground="{Binding RevenueGrowthBrush}" />
                                            </StackPanel>
                                         </Border>
 
                                         <Border Background="{StaticResource TH.CardBackground}" Padding="12" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1">
                                             <StackPanel>
                                                <TextBlock Text="TỔNG LỢI NHUẬN" FontWeight="SemiBold" Foreground="{StaticResource TH.TextSecondary}" />
                                                <TextBlock Text="{Binding TotalProfit, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" />
                                                <TextBlock Text="{Binding ProfitGrowthText}" FontSize="12" Foreground="{Binding ProfitGrowthBrush}" />
                                             </StackPanel>
                                         </Border>
                                    </StackPanel>

                                    <!-- Large placeholder for future chart drawing -->
                                    <Border Grid.Row="1" Background="{StaticResource TH.Layer1Background}" CornerRadius="8" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="240" Margin="0,12,0,0">
                                        <!-- LiveCharts CartesianChart bound to ViewModel -->
                                        <lvc:CartesianChart x:Name="RevenueChart" Series="{Binding ChartSeries}" LegendPosition="Top" />
                                     </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Commission Table (visible only to full admin when selected) -->
                        <Grid Visibility="{x:Bind ViewModel.IsCommissionVisible, Mode=OneWay}">
                            <Border Background="{StaticResource TH.Layer1Background}" CornerRadius="12" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1" MinHeight="360" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{x:Bind ViewModel.CommissionTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TH.TextPrimary}" />

                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CommissionData}" Margin="0,12,0,0" Padding="0" HorizontalContentAlignment="Stretch">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>

                                        <ListView.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="8" Padding="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="0.5*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="0.5*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Họ và Tên" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="Vai trò" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="Doanh số" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="3" Text="% HH" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="4" Text="Tiền HH" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.HeaderTemplate>

                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="reports:CommissionReportDto" xmlns:reports="using:TechHaven.Shared.DTOs.Reports">
                                                <Grid ColumnSpacing="8" Padding="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="0.5*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="0.5*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{x:Bind UserFullName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind RoleName, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind TotalSales, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left">
                                                        <Run Text="{x:Bind CommissionRate}" />
                                                        <Run Text="%" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4" Text="{x:Bind CommissionAmount, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Left" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Footer: total commission -->
                                    <Border Grid.Row="2" BorderBrush="{StaticResource TH.BorderBrush}" BorderThickness="1,0,0,0" Padding="12" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="TỔNG CỘNG PHẢI TRẢ:" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalCommission, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{StaticResource TH.TextPrimary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
