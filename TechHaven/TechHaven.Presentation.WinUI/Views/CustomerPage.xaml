<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CustomerTypeToBrushConverter x:Key="CustomerTypeToBrush"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TH.TextPrimary}" />
        </Style>
        
        <Style x:Key="ListViewItemNoPadding" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="12" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Customers" 
                   Style="{StaticResource SectionTitle}" 
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            
            <TextBox
                Grid.Column="0"
                PlaceholderText="Tìm kiếm theo Tên, SĐT, Email..."
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Height="40"
                Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                
            <ComboBox ItemsSource="{x:Bind ViewModel.SortableProperties}"
                      Grid.Column="1"
                      SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="40"
                      PlaceholderText="Tiêu chí"/>

            <ComboBox ItemsSource="{x:Bind ViewModel.SortDirections}"
                      Grid.Column="2"
                      SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="40"
                      PlaceholderText="Thứ tự"/>

            <Button
                x:Name="AddCustomerButton"
                Grid.Column="3"
                Content="Thêm Khách Hàng"
                HorizontalAlignment="Stretch"
                Background="{StaticResource TH.PrimaryBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                CornerRadius="8"
                Height="40"
                Click="AddCustomer_Click"/>
        </Grid>

        <!-- Customers list wrapped in a card -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Danh sách khách hàng" 
                           FontWeight="SemiBold" 
                           FontSize="16"
                           Margin="0,0,0,12" 
                           Foreground="{StaticResource TH.TextPrimary}"/>

                <!-- Header -->
                <Grid Grid.Row="1" 
                      Margin="0,0,0,8" 
                      Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tên Khách Hàng" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Số Điện Thoại" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="Email" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="Địa chỉ" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="4" Text="Hạng" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="5" Text="Tổng Mua" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" Foreground="{StaticResource TH.TextPrimary}"/>
                </Grid>

                <ListView
                    x:Name="CustomersList"
                    Grid.Row="2"
                    ItemsSource="{Binding Customers}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="CustomersList_ItemClick"
                    Padding="0"
                    ItemContainerStyle="{StaticResource ListViewItemNoPadding}">
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Sửa" Click="EditCustomer_Click" Tag="{Binding}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Xóa" Click="DeleteCustomer_Click" Tag="{Binding}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource TH.DangerBrush}"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding CustomerName}" TextAlignment="Left" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PhoneNumber}" TextAlignment="Left" Foreground="{StaticResource TH.TextPrimary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Email}" TextAlignment="Left" Foreground="{StaticResource TH.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Address}" TextTrimming="CharacterEllipsis" TextAlignment="Left" Foreground="{StaticResource TH.TextSecondary}"/>

                                <Border Grid.Column="4"
                                        CornerRadius="12"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Type, Converter={StaticResource CustomerTypeToBrush}}">
                                    <TextBlock Text="{Binding Type}"
                                               Style="{StaticResource BadgeTextStyle}"/>
                                </Border>

                                <TextBlock Grid.Column="5" Text="{Binding TotalPurchased, Converter={StaticResource DecimalToCurrency}}" TextAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TH.TextPrimary}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Paging controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="12">
            <Button Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    ToolTipService.ToolTip="Trang trước"
                    Width="40" 
                    Height="40"
                    CornerRadius="8"
                    Background="{StaticResource TH.CardBackground}"
                    BorderBrush="{StaticResource TH.BorderBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE96F;" FontSize="16" Foreground="{StaticResource TH.TextPrimary}"/>
            </Button>

            <TextBlock VerticalAlignment="Center" 
                       Text="{Binding PageInfo}" 
                       Foreground="{StaticResource TH.TextPrimary}"
                       FontWeight="SemiBold"/>

            <Button Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    ToolTipService.ToolTip="Trang sau"
                    Width="40" 
                    Height="40"
                    CornerRadius="8"
                    Background="{StaticResource TH.CardBackground}"
                    BorderBrush="{StaticResource TH.BorderBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE970;" FontSize="16" Foreground="{StaticResource TH.TextPrimary}"/>
            </Button>

        </StackPanel>
    </Grid>
</Page>
