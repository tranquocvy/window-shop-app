<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TechHaven.Presentation.WinUI.Converters"
    mc:Ignorable="d"
    Background="#EEEEEE"
    Foreground="#0A2E8C">

    <Page.Resources>
        <converters:CustomerTypeToBrushConverter x:Key="CustomerTypeToBrush"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="16" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Customers" 
                   Style="{ThemeResource TitleTextBlockStyle}" 
                   Margin="0,0,0,12" 
                   Foreground="#0A2E8C"/>

        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                PlaceholderText="Tìm kiếm theo Tên, SĐT, Email..."
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox ItemsSource="{x:Bind ViewModel.SortableProperties}"
                      Grid.Column="1"
                      SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="40"
                      PlaceholderText="Tiêu chí">
            </ComboBox>

            <ComboBox ItemsSource="{x:Bind ViewModel.SortDirections}"
                      Grid.Column="2"
                      SelectedItem="{x:Bind ViewModel.SelectedDirection, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="40"
                      PlaceholderText="Thứ tự">
            </ComboBox>

            <Button
                x:Name="AddCustomerButton"
                Grid.Column="3"
                Content="Thêm Khách Hàng"
                HorizontalAlignment="Stretch"
                Background="#0D47A1"
                Foreground="White"
                FontWeight="Bold"
                CornerRadius="5"
                Height="40"
                Click="AddCustomer_Click"/>
        </Grid>

        <!-- Customers list wrapped in a card-like Border -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="#D0D0D0" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Optional header inside card -->
                <TextBlock Grid.Row="0" Text="Danh sách khách hàng" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#0A2E8C"/>

                <ListView
                    x:Name="CustomersList"
                    Grid.Row="1"
                    ItemsSource="{Binding Customers}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="CustomersList_ItemClick"
                    Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Tên Khách Hàng" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Số Điện Thoại" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="3" Text="Email" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="4" Text="Địa chỉ" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="5" Text="Hạng" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Grid.Column="6" Text="Tổng Mua" FontWeight="SemiBold" TextAlignment="Left"/>
                        </Grid>
                    </ListView.Header>
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bindings to the CustomerDto properties -->
                                <TextBlock Grid.Column="0" Text="{Binding CustomerId}" TextAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding CustomerName}" TextAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="{Binding PhoneNumber}" TextAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="{Binding Email}" TextAlignment="Left"/>
                                <TextBlock Grid.Column="4" Text="{Binding Address}" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>

                                <!-- Colored badge for Type -->
                                <Border Grid.Column="5"
                                        CornerRadius="12"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Type, Converter={StaticResource CustomerTypeToBrush}}">
                                    <TextBlock Text="{Binding Type}"
                                               Style="{StaticResource BadgeTextStyle}"/>
                                </Border>

                                <TextBlock Grid.Column="6" Text="{Binding TotalPurchased, Converter={StaticResource DecimalToCurrency}}" TextAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Paging controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Spacing="8">
            <Button Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    ToolTipService.ToolTip="Trang trước"
                    Width="40" 
                    Height="32">
                <FontIcon Glyph="&#xE96F;"  FontSize="16" Foreground="Black"/>
            </Button>

            <TextBlock VerticalAlignment="Center" Text="{Binding PageInfo}"/>

            <Button Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    ToolTipService.ToolTip="Trang sau"
                    Width="40" 
                    Height="32"
                    >
                <FontIcon Glyph="&#xE970;"  FontSize="16" Foreground="Black"/>
            </Button>

            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="Items per page:"/>
            <ComboBox ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                Height="32">
            </ComboBox>
        </StackPanel>
    </Grid>
</Page>
