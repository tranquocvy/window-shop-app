<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.OrderPage"
    x:Name="OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:vm="using:TechHaven.Presentation.WinUI.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource TH.SurfaceBackground}">

    <Page.DataContext>
        <vm:OrderViewModel />
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{ThemeResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{ThemeResource TH.TextPrimary}" />
        </Style>

        <Style x:Key="ListViewItemNoPadding" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <DataTemplate x:Key="CustomerItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PhoneNumber}" Grid.Column="1" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProductItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Product.ProductName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Product.BrandName}" Grid.Column="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Product.StockQuantity}" Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OrderItemDesktopTemplate" x:DataType="vm:OrderItemViewModel">
            <Grid HorizontalAlignment="Stretch" Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="20*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{x:Bind OrderDateDisplay}" 
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TH.TextPrimary}"/>

                <TextBlock Grid.Column="1" 
                           Text="{x:Bind CustomerDisplay}" 
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TH.TextPrimary}"/>

                <Border Grid.Column="2"
                        CornerRadius="12"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="{x:Bind StatusColor}"/>
                    </Border.Background>
                    <TextBlock Text="{x:Bind StatusDisplay}"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Column="3" 
                           Text="{x:Bind ProductsCountDisplay}" 
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TH.TextSecondary}"/>

                <TextBlock Grid.Column="4" 
                           Text="{x:Bind TotalAmountDisplay}" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TH.TextPrimary}" />

                <TextBlock Grid.Column="5" 
                           Text="{x:Bind Order.Notes}" 
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TH.TextSecondary}"/>

                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Xem Chi Tiết" Click="ViewDetails_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C3;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Cập Nhật Trạng Thái" Click="UpdateStatus_Click"
                                        IsEnabled="{Binding CanChangeStatus}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="In Đơn Hàng" Click="PrintOrder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A7;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Xóa Đơn Hàng" Click="DeleteOrder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource TH.DangerBrush}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OrderItemTabletTemplate" x:DataType="vm:OrderItemViewModel">
            <Border BorderBrush="{ThemeResource TH.BorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind CustomerDisplay}" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Foreground="{ThemeResource TH.TextPrimary}"/>
                            <TextBlock Text="{x:Bind OrderDateDisplay}" 
                                       FontSize="12"
                                       Foreground="{ThemeResource TH.TextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="12"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Bind StatusColor}"/>
                            </Border.Background>
                            <TextBlock Text="{x:Bind StatusDisplay}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sản phẩm" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TH.TextSecondary}"/>
                            <TextBlock Text="{x:Bind ProductsCountDisplay}" 
                                       FontSize="13"
                                       Foreground="{ThemeResource TH.TextPrimary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tổng tiền" 
                                       FontSize="11" 
                                       Foreground="{ThemeResource TH.TextSecondary}"/>
                            <TextBlock Text="{x:Bind TotalAmountDisplay}" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TH.TextPrimary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" 
                               Text="{x:Bind Order.Notes}" 
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TH.TextSecondary}"/>

                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Xem Chi Tiết" Click="ViewDetails_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Cập Nhật Trạng Thái" Click="UpdateStatus_Click"
                                            IsEnabled="{Binding CanChangeStatus}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="In Đơn Hàng" Click="PrintOrder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Xóa Đơn Hàng" Click="DeleteOrder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource TH.DangerBrush}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Desktop">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="721" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DesktopLayout.Visibility" Value="Visible" />
                        <Setter Target="TabletLayout.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Tablet">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DesktopLayout.Visibility" Value="Collapsed" />
                        <Setter Target="TabletLayout.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Desktop Layout (>720px) -->
        <Grid x:Name="DesktopLayout" Padding="24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Orders" 
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,16"/>

            <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="Tìm kiếm theo khách hàng"
                         Height="40"
                         Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusList}"
                          SelectedItem="{Binding SelectedStatusItem, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          PlaceholderText="Trạng thái"
                          Height="40"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="StatusFilter_SelectionChanged"/>

                <CalendarDatePicker Grid.Column="2"
                                    Date="{Binding FromDate, Mode=TwoWay}"
                                    PlaceholderText="Từ ngày"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="FromDate_DateChanged"/>

                <CalendarDatePicker Grid.Column="3"
                                    Date="{Binding ToDate, Mode=TwoWay}"
                                    PlaceholderText="Đến ngày"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="ToDate_DateChanged"/>

                <Button Grid.Column="4"
                        Content="Tìm"
                        Command="{Binding SearchCommand}"
                        Background="{ThemeResource TH.PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        Height="40"
                        HorizontalAlignment="Stretch"/>

                <Button Grid.Column="7"
                        Click="CreateOrder_Click"
                        Background="{ThemeResource TH.PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Tạo Đơn Hàng" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Danh sách đơn hàng" 
                               FontWeight="SemiBold" 
                               FontSize="16"
                               Margin="0,0,0,12" 
                               Foreground="{ThemeResource TH.TextPrimary}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ngày Đặt" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="Khách Hàng" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock Grid.Column="2" Text="Trạng Thái" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock Grid.Column="3" Text="Sản Phẩm" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock Grid.Column="4" Text="Tổng Tiền" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock Grid.Column="5" Text="Ghi Chú" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TH.TextPrimary}"/>
                    </Grid>

                    <ListView Grid.Row="2"
                              x:Name="OrdersListView"
                              ItemsSource="{Binding Orders}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OrdersList_ItemClick"
                              ItemTemplate="{StaticResource OrderItemDesktopTemplate}"
                              ItemContainerStyle="{StaticResource ListViewItemNoPadding}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="12">
                <Button Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        ToolTipService.ToolTip="Trang trước"
                        Width="40" Height="40" CornerRadius="8"
                        Background="{ThemeResource TH.CardBackground}"
                        BorderBrush="{ThemeResource TH.BorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE96F;" FontSize="16" Foreground="{ThemeResource TH.TextPrimary}"/>
                </Button>

                <TextBlock VerticalAlignment="Center" 
                           Text="{Binding PageInfo}"
                           Foreground="{ThemeResource TH.TextPrimary}"
                           FontWeight="SemiBold"/>

                <Button Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        ToolTipService.ToolTip="Trang sau"
                        Width="40" Height="40" CornerRadius="8"
                        Background="{ThemeResource TH.CardBackground}"
                        BorderBrush="{ThemeResource TH.BorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE970;" FontSize="16" Foreground="{ThemeResource TH.TextPrimary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tablet Layout (<=720px) -->
        <ScrollViewer x:Name="TabletLayout" Visibility="Collapsed">
            <StackPanel Padding="16" Spacing="16">
                <TextBlock Text="Orders" 
                           Style="{StaticResource SectionTitle}"/>

                <StackPanel Spacing="12">
                    <TextBox PlaceholderText="Tìm kiếm theo khách hàng"
                             Height="40"
                             Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding StatusList}"
                                  SelectedItem="{Binding SelectedStatusItem, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  PlaceholderText="Trạng thái"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="StatusFilter_SelectionChanged"/>

                        <Button Grid.Column="1"
                                Content="Tìm"
                                Command="{Binding SearchCommand}"
                                Background="{ThemeResource TH.PrimaryBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="8"
                                Height="40"
                                HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CalendarDatePicker Grid.Column="0"
                                            Date="{Binding FromDate, Mode=TwoWay}"
                                            PlaceholderText="Từ ngày"
                                            Height="40"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="FromDate_DateChanged"/>

                        <CalendarDatePicker Grid.Column="1"
                                            Date="{Binding ToDate, Mode=TwoWay}"
                                            PlaceholderText="Đến ngày"
                                            Height="40"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="ToDate_DateChanged"/>
                    </Grid>

                    <Button Click="CreateOrder_Click"
                            Background="{ThemeResource TH.PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16"/>
                            <TextBlock Text="Tạo Đơn Hàng" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Danh sách đơn hàng" 
                                   FontWeight="SemiBold" 
                                   FontSize="16"
                                   Margin="0,0,0,12" 
                                   Foreground="{ThemeResource TH.TextPrimary}"/>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding Orders}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OrdersList_ItemClick"
                                  ItemTemplate="{StaticResource OrderItemTabletTemplate}"
                                  ItemContainerStyle="{StaticResource ListViewItemNoPadding}"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Width="44" Height="44" CornerRadius="8"
                            Background="{ThemeResource TH.CardBackground}"
                            BorderBrush="{ThemeResource TH.BorderBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE96F;" FontSize="18" Foreground="{ThemeResource TH.TextPrimary}"/>
                    </Button>

                    <TextBlock VerticalAlignment="Center" 
                               Text="{Binding PageInfo}"
                               Foreground="{ThemeResource TH.TextPrimary}"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <Button Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            Width="44" Height="44" CornerRadius="8"
                            Background="{ThemeResource TH.CardBackground}"
                            BorderBrush="{ThemeResource TH.BorderBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE970;" FontSize="18" Foreground="{ThemeResource TH.TextPrimary}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
