<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.OrderPage"
    x:Name="OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:vm="using:TechHaven.Presentation.WinUI.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:OrderViewModel />
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TH.CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource TH.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource TH.TextPrimary}" />
        </Style>

        <Style x:Key="ListViewItemNoPadding" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Customer item template used by the customer selector dialog -->
        <DataTemplate x:Key="CustomerItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PhoneNumber}" Grid.Column="1" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- Product item template used by the product selector dialog -->
        <DataTemplate x:Key="ProductItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Product.ProductName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Product.BrandName}" Grid.Column="1" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Product.StockQuantity}" Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Orders" 
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,16"/>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <TextBox
                Grid.Column="0"
                PlaceholderText="Tìm kiếm theo ID, khách hàng, sản phẩm..."
                VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Height="40"
                Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Status Filter -->
            <ComboBox 
                Grid.Column="1"
                ItemsSource="{Binding StatusList}"
                SelectedItem="{Binding SelectedStatusItem, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                PlaceholderText="Trạng thái"
                HorizontalAlignment="Stretch"
                Height="40"
                SelectionChanged="StatusFilter_SelectionChanged"/>

            <!-- From Date -->
            <CalendarDatePicker
                Grid.Column="2"
                Date="{Binding FromDate, Mode=TwoWay}"
                PlaceholderText="Từ ngày"
                HorizontalAlignment="Stretch"
                Height="40"
                DateChanged="FromDate_DateChanged"/>

            <!-- To Date -->
            <CalendarDatePicker
                Grid.Column="3"
                Date="{Binding ToDate, Mode=TwoWay}"
                PlaceholderText="Đến ngày"
                HorizontalAlignment="Stretch"
                Height="40"
                DateChanged="ToDate_DateChanged"/>

            <!-- Search Button -->
            <Button 
                Grid.Column="4"
                Content="Tìm"
                Command="{Binding SearchCommand}"
                Background="{StaticResource TH.PrimaryBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                CornerRadius="8"
                Height="40"
                HorizontalAlignment="Stretch"/>

            <!-- Create Order Button -->
            <Button
                Grid.Column="7"
                Click="CreateOrder_Click"
                Background="{StaticResource TH.PrimaryBrush}"
                Foreground="White"
                FontWeight="SemiBold"
                CornerRadius="8"
                Height="40"
                HorizontalAlignment="Stretch"
                Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Tạo Đơn Hàng" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Orders List Card -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Danh sách đơn hàng" 
                           FontWeight="SemiBold" 
                           FontSize="16"
                           Margin="0,0,0,12" 
                           Foreground="{StaticResource TH.TextPrimary}"/>

                <!-- Header -->
                <Grid Grid.Row="1" 
                      Margin="0,0,0,8" 
                      Padding="12,8"
                      CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ngày Đặt" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Khách Hàng" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="Trạng Thái" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="Sản Phẩm" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="4" Text="Tổng Tiền" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                    <TextBlock Grid.Column="5" Text="Ghi Chú" FontWeight="SemiBold" FontSize="12" TextAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TH.TextPrimary}"/>
                </Grid>

                <ListView
                    Grid.Row="2"
                    x:Name="OrdersListView"
                    ItemsSource="{Binding Orders}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OrdersList_ItemClick"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    ItemContainerStyle="{StaticResource ListViewItemNoPadding}">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                            <Grid HorizontalAlignment="Stretch" Margin="0" Padding="12,8">
                                <!-- Use same star ratios as header -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="20*"/>
                                    <ColumnDefinition Width="20*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Order Date -->
                                <TextBlock Grid.Column="0" 
                                           Text="{x:Bind OrderDateDisplay}" 
                                           TextAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TH.TextPrimary}"/>

                                <!-- Customer Name -->
                                <TextBlock Grid.Column="1" 
                                           Text="{x:Bind CustomerDisplay}" 
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TH.TextPrimary}"/>

                                <!-- Status Badge -->
                                <Border Grid.Column="2"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{x:Bind StatusColor}"/>
                                    </Border.Background>
                                    <TextBlock Text="{x:Bind StatusDisplay}"
                                               Foreground="White"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Products Count -->
                                <TextBlock Grid.Column="3" 
                                           Text="{x:Bind ProductsCountDisplay}" 
                                           TextAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TH.TextSecondary}"/>

                                <!-- Total Amount -->
                                <TextBlock Grid.Column="4" 
                                           Text="{x:Bind TotalAmountDisplay}" 
                                           FontWeight="Bold"
                                           TextAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TH.TextPrimary}" />

                                <!-- Notes -->
                                <TextBlock Grid.Column="5" 
                                           Text="{x:Bind Order.Notes}" 
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TH.TextSecondary}"
                                           MinWidth="120"/>

                                <!-- Context Menu -->
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem 
                                            Text="Xem Chi Tiết"
                                            Click="ViewDetails_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7C3;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem 
                                            Text="Cập Nhật Trạng Thái"
                                            Click="UpdateStatus_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem
                                            Text="In Đơn Hàng"
                                            Click="PrintOrder_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem 
                                            Text="Xóa Đơn Hàng"
                                            Click="DeleteOrder_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource TH.DangerBrush}"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Pagination -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Spacing="12">

            <Button 
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}"
                ToolTipService.ToolTip="Trang trước"
                Width="40" 
                Height="40"
                CornerRadius="8"
                Background="{StaticResource TH.CardBackground}"
                BorderBrush="{StaticResource TH.BorderBrush}"
                BorderThickness="1">
                <FontIcon Glyph="&#xE96F;" FontSize="16" Foreground="{StaticResource TH.TextPrimary}"/>
            </Button>

            <TextBlock 
                VerticalAlignment="Center" 
                Text="{Binding PageInfo}"
                Foreground="{StaticResource TH.TextPrimary}"
                FontWeight="SemiBold"/>

            <Button 
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}"
                ToolTipService.ToolTip="Trang sau"
                Width="40" 
                Height="40"
                CornerRadius="8"
                Background="{StaticResource TH.CardBackground}"
                BorderBrush="{StaticResource TH.BorderBrush}"
                BorderThickness="1">
                <FontIcon Glyph="&#xE970;" FontSize="16" Foreground="{StaticResource TH.TextPrimary}"/>
            </Button>

            <TextBlock 
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                Text="Items per page:"
                Foreground="{StaticResource TH.TextSecondary}"/>

            <ComboBox 
                Height="40"
                MinWidth="80"
                SelectedValue="{Binding PageSize, Mode=TwoWay}"
                SelectedValuePath="Content">
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="10" IsSelected="True"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="50"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Page>
