<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechHaven.Presentation.WinUI.Views.OrderPage"
    x:Name="OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:vm="using:TechHaven.Presentation.WinUI.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White"
    Foreground="#0A2E8C">

    <Page.DataContext>
        <vm:OrderViewModel />
    </Page.DataContext>

    <Grid Padding="16" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="Orders"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,12"
                   Foreground="#0A2E8C"/>

        <!-- SEARCH + FILTERS + ADD BUTTON -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 1: Search + Filters -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <TextBox
                    PlaceholderText="Search by order ID, customer, product..."
                    Width="300"
                    Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox 
                    Width="150"
                    ItemsSource="{Binding StatusList}"
                    SelectedItem="{Binding SelectedStatusItem, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    PlaceholderText="Status"
                    SelectionChanged="StatusFilter_SelectionChanged"/>

                <CalendarDatePicker
                    Width="150"
                    Date="{Binding FromDate, Mode=TwoWay}"
                    PlaceholderText="From Date"
                    DateChanged="FromDate_DateChanged"/>

                <CalendarDatePicker
                    Width="150"
                    Date="{Binding ToDate, Mode=TwoWay}"
                    PlaceholderText="To Date"
                    DateChanged="ToDate_DateChanged"/>

                <Button 
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    Background="#0D47A1"
                    Foreground="White"
                    CornerRadius="5"
                    Height="40"/>

                <Button 
                    Content="Clear Filters"
                    Command="{Binding ClearFilterCommand}"
                    Background="#757575"
                    Foreground="White"
                    CornerRadius="5"
                    Height="40"/>
            </StackPanel>

            <!-- Row 2: Add Order Button -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button
                    Content="Create Order"
                    Click="CreateOrder_Click"
                    Background="#0D47A1"
                    Foreground="White"
                    FontWeight="Bold"
                    CornerRadius="5"
                    Height="40"
                    Width="200"/>
            </StackPanel>
        </Grid>

        <!-- ORDERS LIST -->
        <ListView
            Grid.Row="2"
            x:Name="OrdersListView"
            ItemsSource="{Binding Orders}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OrdersList_ItemClick"
            Padding="0">
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <Grid Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Order ID" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Order Date" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="Customer" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="4" Text="Products" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="5" Text="Total Amount" FontWeight="SemiBold" TextAlignment="Left"/>
                    <TextBlock Grid.Column="6" Text="Notes" FontWeight="SemiBold" TextAlignment="Left"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderItemViewModel">
                    <Grid Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Order ID -->
                        <TextBlock Grid.Column="0" 
                                   Text="{x:Bind Order.OrderId}" 
                                   TextAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <!-- Order Date -->
                        <TextBlock Grid.Column="1" 
                                   Text="{x:Bind OrderDateDisplay}" 
                                   TextAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <!-- Customer Name -->
                        <TextBlock Grid.Column="2" 
                                   Text="{x:Bind CustomerDisplay}" 
                                   TextAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Status Badge -->
                        <Border Grid.Column="3"
                                CornerRadius="12"
                                Padding="8,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Bind StatusColor}"/>
                            </Border.Background>
                            <TextBlock Text="{x:Bind StatusDisplay}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- Products Count -->
                        <TextBlock Grid.Column="4" 
                                   Text="{x:Bind ProductsCountDisplay}" 
                                   TextAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <!-- Total Amount -->
                        <TextBlock Grid.Column="5" 
                                   Text="{x:Bind TotalAmountDisplay}" 
                                   FontWeight="SemiBold"
                                   TextAlignment="Left"
                                   VerticalAlignment="Center"/>

                        <!-- Notes -->
                        <TextBlock Grid.Column="6" 
                                   Text="{x:Bind Order.Notes}" 
                                   TextAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Context Menu -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem 
                                    Text="View Details"
                                    Click="ViewDetails_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem 
                                    Text="Update Status"
                                    Click="UpdateStatus_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem 
                                    Text="Delete Order"
                                    Click="DeleteOrder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" Foreground="Red"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- PAGINATION -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    Spacing="8">

            <Button 
                Content="Previous"
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}"/>
            
            <TextBlock 
                VerticalAlignment="Center" 
                Text="{Binding PageInfo}"/>
            
            <Button 
                Content="Next"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}"/>

            <TextBlock 
                VerticalAlignment="Center"
                Margin="12,0,0,0"
                Text="Items per page:"/>

            <ComboBox 
                Width="80"
                SelectedValue="{Binding PageSize, Mode=TwoWay}"
                SelectedValuePath="Content">
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="10" IsSelected="True"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="50"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Page>
