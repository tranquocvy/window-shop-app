<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TechHaven.Presentation.WinUI.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ShellWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            x:Name="navView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionFollowsFocus="Enabled"
            Loaded="navView_Loaded"
            ItemInvoked="navView_ItemInvoked"
            Background="#0A2E8C"
            Foreground="White">

            <!-- Header logo -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" 
                Padding="12,12,0,12" 
                Margin="0,20,0,0">
                    <PersonPicture ProfilePicture="ms-appx:///Assets/avatar.jpg" DisplayName="User"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock 
                            x:Name="currentUserFullNameText" 
                            Text="Loading..." 
                            Style="{ThemeResource BaseTextBlockStyle}"
                            FontWeight="SemiBold"/>
                        <TextBlock 
                            x:Name="currentUserRoleText" 
                            Text="Loading role..." 
                            Style="{ThemeResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <!-- Menu items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Products" Tag="product">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Orders" Tag="order">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE14C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Customers" Tag="customer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Report" Tag="report">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="setting">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Log Out" Tag="logout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="contentFrame"/>
        </NavigationView>
    </Grid>
</Window>
