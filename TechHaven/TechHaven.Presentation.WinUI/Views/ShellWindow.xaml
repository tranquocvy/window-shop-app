<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TechHaven.Presentation.WinUI.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TechHaven.Presentation.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ShellWindow">

    <Grid x:Name="rootGrid" Background="{ThemeResource TH.SurfaceBackground}">
        <Grid.Resources>
            <Style TargetType="IconElement">
                <Setter Property="Foreground" Value="{ThemeResource TH.TextPrimary}" />
            </Style>

            <Style TargetType="Button" x:Key="NavToggleButtonStyle">
                <Setter Property="Foreground" Value="{ThemeResource TH.TextPrimary}" />
                <Setter Property="Background" Value="{ThemeResource TH.NavBackground}" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="navView"
            OpenPaneLength="220"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionFollowsFocus="Disabled"
            Loaded="navView_Loaded"
            ItemInvoked="navView_ItemInvoked"
            Background="{ThemeResource TH.NavBackground}"
            Foreground="{ThemeResource TH.TextPrimary}">

            <!-- Header logo -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" 
                            Padding="12,12,0,12" 
                            Margin="0,20,0,0">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="ms-appx:///Assets/avatar.jpg" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock 
                            x:Name="currentUserFullNameText" 
                            Text="Loading..." 
                            Style="{ThemeResource BaseTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TH.TextPrimary}"/>
                        <TextBlock 
                            x:Name="currentUserRoleText" 
                            Text="Loading role..." 
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TH.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Menu items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Products" Tag="product" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Orders" Tag="order" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE14C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Customers" Tag="customer" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Report" Tag="report" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Settings" Tag="setting" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Log Out" Tag="logout" Foreground="{ThemeResource TH.TextSecondary}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="contentFrame"/>
        </NavigationView>

        <!-- ChatBot UI -->
        <Grid x:Name="ChatBotRoot">
            <!-- Minimized Button (floating) -->
            <Button 
                x:Name="ChatMinimizedButton"
                Width="60" 
                Height="60"
                CornerRadius="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="0">
                <FontIcon Glyph="&#xE8F2;" FontSize="24" Foreground="White"/>
            </Button>

            <!-- Expanded Chat Window -->
            <Grid 
                x:Name="ChatExpandedWindow"
                Width="380" 
                Height="550"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Visibility="Collapsed"
                Background="{ThemeResource TH.NavBackground}"
                CornerRadius="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" 
                      Background="{ThemeResource AccentFillColorDefaultBrush}" 
                      Padding="16,12"
                      CornerRadius="12,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" 
                             Glyph="&#xE8F2;" 
                             FontSize="20" 
                             Foreground="White"
                             VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                              Text="AI Assistant" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"/>

                    <Button Grid.Column="2"
                           x:Name="ChatCloseButton"
                           Width="32" 
                           Height="32"
                           Background="Transparent"
                           BorderThickness="0"
                           VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Chat Messages Area -->
                <ScrollViewer Grid.Row="1" 
                             x:Name="ChatMessageScrollViewer"
                             VerticalScrollBarVisibility="Auto"
                             Padding="16">
                    <StackPanel x:Name="ChatMessagesPanel" Spacing="12">
                        <!-- Welcome message -->
                        <Grid>
                            <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                   Padding="12"
                                   CornerRadius="8"
                                   MaxWidth="300"
                                   HorizontalAlignment="Left">
                                <TextBlock Text="Hello! I'm your AI assistant. How can I help you today?"
                                         TextWrapping="Wrap"
                                         Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input Area -->
                <Grid Grid.Row="2" 
                      Padding="16"
                      Background="{ThemeResource LayerFillColorAltBrush}"
                      CornerRadius="0,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ChatMessageInputBox"
                            Grid.Column="0"
                            PlaceholderText="Type your message..."
                            MaxHeight="100"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                           x:Name="ChatSendButton"
                           Width="40" 
                           Height="40"
                           Margin="8,0,0,0"
                           CornerRadius="20"
                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                           BorderThickness="0"
                           VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE724;" FontSize="16" Foreground="White"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
