<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="TH.PrimaryColor">#FF4F6BED</Color>
    <Color x:Key="TH.SecondaryColor">#FF6C59F5</Color>
    <Color x:Key="TH.SuccessColor">#FF4CAF50</Color>
    <Color x:Key="TH.WarningColor">#FFFFC107</Color>
    <Color x:Key="TH.DangerColor">#FFF44336</Color>

    <!-- Radii -->
    <CornerRadius x:Key="TH.Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="TH.Radius.Medium">12</CornerRadius>
    <CornerRadius x:Key="TH.Radius.Large">20</CornerRadius>

    <!-- Spacing -->
    <x:Double x:Key="TH.Spacing.XS">4</x:Double>
    <x:Double x:Key="TH.Spacing.SM">8</x:Double>
    <x:Double x:Key="TH.Spacing.MD">16</x:Double>
    <x:Double x:Key="TH.Spacing.LG">24</x:Double>

    <!-- Elevation -->
    <x:Double x:Key="TH.Shadow.Depth1">2</x:Double>
    <x:Double x:Key="TH.Shadow.Depth2">6</x:Double>

    <!-- Typography -->
    <FontFamily x:Key="TH.Font.Main">Segoe UI Variable</FontFamily>

</ResourceDictionary>
