<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Common.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Accents.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================================= -->
    <!-- =====================   COLORS   ========================= -->
    <!-- ========================================================= -->
    <!-- ?? Ocean Blue Light Theme - Darker for Better Contrast -->

    <!-- ========== Background Layers (Darker Blue palette) ========== -->
    <Color x:Key="TH.Color.SurfaceBackground">#FFC5E1EA</Color>
    <!-- main app background - medium blue -->
    <Color x:Key="TH.Color.Layer1Background">#FFD4E9F0</Color>
    <!-- secondary layer - soft blue -->
    <Color x:Key="TH.Color.CardBackground">#FFE3F2F7</Color>
    <!-- card background - light blue -->
    <Color x:Key="TH.Color.NavBackground">#FFB8D9E8</Color>
    <!-- navigation panel - stronger blue -->

    <!-- ========== Borders ========== -->
    <Color x:Key="TH.Color.Border">#FF8FC4D9</Color>
    <!-- visible blue border -->
    <Color x:Key="TH.Color.Divider">#FFA8D3E3</Color>
    <!-- blue divider -->

    <!-- ========== Text (Pure Black for maximum readability) ========== -->
    <Color x:Key="TH.Color.TextPrimary">#FF000000</Color>
    <!-- primary text - pure black -->
    <Color x:Key="TH.Color.TextSecondary">#FF1A1A1A</Color>
    <!-- secondary text - almost black -->
    <Color x:Key="TH.Color.TextDisabled">#FF666666</Color>
    <!-- disabled text - dark gray -->

    <!-- ========== Nav Item States ========== -->
    <Color x:Key="TH.Color.NavItemPointerOver">#FF1E88E5</Color>
    <!-- bright blue hover -->
    <Color x:Key="TH.Color.NavItemSelected">#FF1976D2</Color>
    <!-- blue selected -->

    <!-- ========================================================= -->
    <!-- ======================= BRUSHES ========================= -->
    <!-- ========================================================= -->

    <!-- ========== Background Brushes ========== -->
    <SolidColorBrush x:Key="TH.SurfaceBackground"
                     Color="{StaticResource TH.Color.SurfaceBackground}" />

    <SolidColorBrush x:Key="TH.Layer1Background"
                     Color="{StaticResource TH.Color.Layer1Background}" />

    <SolidColorBrush x:Key="TH.CardBackground"
                     Color="{StaticResource TH.Color.CardBackground}" />

    <SolidColorBrush x:Key="TH.NavBackground"
                     Color="{StaticResource TH.Color.NavBackground}" />

    <!-- NavigationView item brushes -->
    <SolidColorBrush x:Key="TH.NavItemPointerOver" Color="{StaticResource TH.Color.NavItemPointerOver}" />
    <SolidColorBrush x:Key="TH.NavItemSelected" Color="{StaticResource TH.Color.NavItemSelected}" />

    <!-- ========== Border Brushes ========== -->
    <SolidColorBrush x:Key="TH.BorderBrush"
                     Color="{StaticResource TH.Color.Border}" />

    <SolidColorBrush x:Key="TH.DividerBrush"
                     Color="{StaticResource TH.Color.Divider}" />

    <!-- ========== Text Brushes ========== -->
    <SolidColorBrush x:Key="TH.TextPrimary"
                     Color="{StaticResource TH.Color.TextPrimary}" />

    <SolidColorBrush x:Key="TH.TextSecondary"
                     Color="{StaticResource TH.Color.TextSecondary}" />

    <SolidColorBrush x:Key="TH.TextDisabled"
                     Color="{StaticResource TH.Color.TextDisabled}" />

    <!-- ========================================================= -->
    <!-- ======== SYSTEM CONTROL OVERRIDES (TextBox, ComboBox) ====== -->
    <!-- ========================================================= -->

    <!-- TextBox Placeholder and Text Colors -->
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource TH.Color.TextDisabled}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TH.Color.TextSecondary}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TH.Color.TextSecondary}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TH.Color.TextSecondary}" />

    <!-- ComboBox Text and Dropdown Item Colors -->
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource TH.Color.TextDisabled}" />
    <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource TH.Color.TextSecondary}" />

    <!-- ComboBox Dropdown Items -->
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource TH.Color.TextPrimary}" />

    <!-- Map to NavigationView system resource keys -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource TH.Color.NavItemPointerOver}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource TH.Color.NavItemSelected}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{StaticResource TH.Color.NavItemSelected}" />

    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />

    <!-- Additional states -->
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource TH.Color.TextDisabled}" />

    <!-- Map success/danger colors from Common -->
    <SolidColorBrush x:Key="TH.SuccessBrush" Color="{StaticResource TH.SuccessColor}" />
    <SolidColorBrush x:Key="TH.DangerBrush" Color="{StaticResource TH.DangerColor}" />

    <!-- ========================================================= -->
    <!-- ========== CalendarDatePicker Text Colors ========== -->
    <!-- ========================================================= -->
    <!-- Colors for the control itself, not the dropdown -->
    <SolidColorBrush x:Key="CalendarDatePickerForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerForegroundFocused" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerForegroundDisabled" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerCalendarGlyphForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerCalendarGlyphForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />

    <!-- CalendarDatePicker TextBox (the date display field) -->
    <SolidColorBrush x:Key="CalendarDatePickerTextForeground" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerTextForegroundPointerOver" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerTextForegroundFocused" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerTextForegroundDisabled" Color="{StaticResource TH.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CalendarDatePickerHeaderForeground" Color="{StaticResource TH.Color.TextPrimary}" />

</ResourceDictionary>